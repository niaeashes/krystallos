# gitsynth behind a reverse proxy that terminates TLS (see deploy/Caddyfile).
# Install as /etc/systemd/system/gitsynth.service; the README's "Running on a
# server" has the steps.

[Unit]
Description=gitsynth Git forge
After=network.target

[Service]
# The server must run as the user that owns the data directory: it runs git
# with that user's git config ignored, so safe.directory cannot excuse
# repositories owned by anyone else.
User=gitsynth
Group=gitsynth
ExecStart=/usr/local/bin/gitsynth serve --data /var/lib/gitsynth --listen 127.0.0.1:3000
# git expects a home directory; keep it inside the data directory.
Environment=HOME=/var/lib/gitsynth
Restart=on-failure
RestartSec=5s
# On stop, SIGTERM goes to the server alone, which lets requests in flight
# finish for up to 5 seconds along with the git processes and hooks they
# started (by default those would get SIGTERM at the same moment). Whatever
# is left once the server exits is killed.
KillMode=mixed

# Hardening. git and the hook run as children of the server and inherit all
# of this: the hook is this same binary, reads only the data directory, and
# reports to the server over loopback TCP.
NoNewPrivileges=yes
# It listens above port 1024 and needs no capabilities.
CapabilityBoundingSet=
# Everything but the data directory (and a private /tmp) is read-only.
ProtectSystem=strict
ReadWritePaths=/var/lib/gitsynth
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# TCP (clients, and the hook reporting to the server) and Unix sockets only.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
